# Flask Configuration
SECRET_KEY="a-very-long-and-random-secret-key-for-development"
RECRUITER_ACCESS_CODE="change-this-secret-code"


# --- LLM Configuration ---

# Set the desired LLM provider.
# Supported values: "anthropic", "openai", "gemini"
# Defaults to "anthropic" if not set.
LLM_PROVIDER="anthropic"


# --- API Keys (only provide the one for your selected LLM_PROVIDER) ---

# For Anthropic
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# For OpenAI
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# For Google Gemini
GEMINI_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
