# --- Flask Core Settings ---
# Generate a strong, random secret key for production environments.
# You can generate one with: python -c 'import secrets; print(secrets.token_hex(24))'
SECRET_KEY="your-super-secret-key-here"

# Development server (python run.py) only. FLASK_DEBUG=1 turns on the debugger
# and auto-reload; FLASK_RUN_HOST defaults to 127.0.0.1 (localhost only).
# FLASK_DEBUG=1
# FLASK_RUN_HOST=127.0.0.1

# --- View Access ---
# The code required to access the recruiter and CLI views.
RECRUITER_ACCESS_CODE="your-secret-access-code"

# --- Portfolio Content ---
# Folder with cv.yaml, projects.yaml, text_config.yaml, system_prompt.txt, logo/ and images/.
# Relative paths are resolved from the project root. Defaults to the bundled example in data/.
# PORTFOLIO_DATA_DIR="data"

# --- Languages ---
# Languages the site is offered in (comma-separated), the first being the fallback.
# Texts in the data files can be translated per language; with one language the
# switcher is hidden.
# PORTFOLIO_LANGUAGES="en,es"
# Language for browsers that ask for none of the above. Defaults to the first one.
# PORTFOLIO_DEFAULT_LANGUAGE="en"

# --- UI Feature Flags ---
# Set to "true" to display a floating banner across all views. Useful for maintenance or pre-launch.
BANNER_ENABLED="false"
# The message to display in the banner when it's enabled.
BANNER_MESSAGE="Please note: This site is under active configuration. Final updates are planned by July 21st."

# --- LLM (Large Language Model) Configuration ---
# The chat talks to any provider through LiteLLM. LLM_MODEL is "<provider>/<model>", e.g.:
#   openrouter/anthropic/claude-haiku-4.5   (needs OPENROUTER_API_KEY)
#   anthropic/claude-haiku-4-5-20251001     (needs ANTHROPIC_API_KEY)
#   openai/gpt-4.1-mini                     (needs OPENAI_API_KEY)
#   gemini/gemini-2.5-flash                 (needs GEMINI_API_KEY)
#   ollama/llama3.1                         (no key; set LLM_API_BASE="http://localhost:11434")
# The model must support tool (function) calling.
LLM_MODEL="openrouter/anthropic/claude-haiku-4.5"

# --- API Keys ---
# Set the key of the provider in LLM_MODEL, under its usual name.
OPENROUTER_API_KEY="sk-or-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# OPENAI_API_KEY="sk-..."
# GEMINI_API_KEY="AIza..."

# --- Optional LLM Settings ---
# A key that overrides the provider variable above, and a custom endpoint.
# LLM_API_KEY=""
# LLM_API_BASE=""
# Seconds to wait for each model response, and rounds of tool calls per question.
# LLM_TIMEOUT="30"
# LLM_MAX_TOOL_ROUNDS="5"
# Most tokens per response (reasoning included), and the reasoning effort of models
# that reason: "none" turns it off where allowed; "low", "medium", "high" set it.
# LLM_MAX_TOKENS="1024"
# LLM_REASONING_EFFORT="none"
# Models tried in order when LLM_MODEL fails, each with an optional "@<reasoning effort>"
# (LLM_REASONING_EFFORT is only for LLM_MODEL), e.g. "openrouter/deepseek/deepseek-v4-flash@none".
# LLM_FALLBACK_MODELS=""

# --- Abuse Limits (per client IP) ---
# Longest chat message, in characters; longer ones are refused with a notice.
# CHAT_MAX_MESSAGE_CHARS="2000"
# Chat messages a client may send, as "<count>/<period>" (second, minute, hour, day).
# CHAT_RATE_LIMITS="8/minute,60/hour,200/day"
# Wrong access codes a client may try before every attempt is refused for a while.
# AUTH_FAILURE_LIMITS="5/15minute,20/day"
# Behind a reverse proxy, how many proxies set X-Forwarded-For (1 behind Nginx).
# Without it every visitor shares the proxy's address and one limit.
# PROXY_COUNT="0"
