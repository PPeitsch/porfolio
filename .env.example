# --- Flask Core Settings ---
# Generate a strong, random secret key for production environments.
# You can generate one with: python -c 'import secrets; print(secrets.token_hex(24))'
SECRET_KEY="your-super-secret-key-here"

# --- View Access ---
# The code required to access the recruiter and CLI views.
RECRUITER_ACCESS_CODE="your-secret-access-code"

# --- UI Feature Flags ---
# Set to "true" to display a floating banner across all views. Useful for maintenance or pre-launch.
BANNER_ENABLED="false"
# The message to display in the banner when it's enabled.
BANNER_MESSAGE="Please note: This site is under active configuration. Final updates are planned by July 21st."

# --- LLM (Large Language Model) Configuration ---
# Set the desired LLM provider. Supported values: "anthropic", "openai", "gemini".
LLM_PROVIDER="anthropic"

# --- API Keys ---
# Provide the API key for the selected provider. You only need to set the one you are using.
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."
GEMINI_API_KEY="AIza..."

# --- Gemini Proxy (Optional) ---
# Route Gemini requests through an HTTP proxy instead of calling the API directly.
# GEMINI_API_KEY must still be set (any non-empty value) when the proxy holds the real key.
# GEMINI_PROXY_URL="https://your-proxy.example.com/chat"

# --- LLM Model Names (Optional) ---
# You can override the default models used by each provider.
# ANTHROPIC_MODEL="claude-sonnet-5-5"
# OPENAI_MODEL="gpt-4-turbo"
# GEMINI_MODEL="gemini-2.5-flash"
