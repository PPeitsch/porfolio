[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    venv,
    .venv,
    env,
    ENV,
    instance,
    migrations,
    dist,
    build
per-file-ignores =
    shell/__init__.py:F541
    view_cli/__init__.py:E402,F401
    view_recruiter/__init__.py:E402,F401
    view_visual/__init__.py:E402,F401
